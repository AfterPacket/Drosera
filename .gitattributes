# Line-ending policy.
#
# This project is authored on Windows and deployed on Linux, which makes CRLF a
# real hazard rather than a cosmetic one: a shell script checked out with CRLF
# fails on Linux as
#
#   /bin/bash^M: bad interpreter: No such file or directory
#
# and the same applies to anything COPYed into a container. Everything here is
# therefore pinned to LF in the repository *and* on checkout, on every platform.

* text=auto eol=lf

# Executed on Linux -- CRLF breaks the shebang.
*.sh        text eol=lf
entrypoint.sh text eol=lf

# Read by Docker, nginx, php-fpm, fail2ban, logrotate and sysctl. Several of
# these parsers treat a trailing CR as part of a value.
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
*.ini       text eol=lf
logrotate-* text eol=lf

# Source.
*.py        text eol=lf
*.php       text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.json      text eol=lf
*.md        text eol=lf

# asciicast recordings are newline-delimited JSON and are parsed line by line.
*.cast      text eol=lf

# Never normalise these.
*.mmdb      binary
*.gif       binary
*.mp4       binary
*.png       binary
*.jpg       binary
*.ico       binary
*.gz        binary
*.pem       binary
*.key       binary
